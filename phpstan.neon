includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:

    paths:
        - src/

    # The level 9 is the highest level
    level: 5

    ignoreErrors:
        - '#PHPDoc tag @var#'
        - "#Access to an undefined property#"
        - "#Call to an undefined method#"

#    excludePaths:
#        - ./*/*/FileToBeExcluded.php

    reportUnmatchedIgnoredErrors: false
